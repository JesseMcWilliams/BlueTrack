<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site-root web.config for the built BlueTrack SPA (App/Web/dist/).

  This is the piece Design Documents/Design_Deployment_Methodology.md flagged
  as not yet built anywhere in the repo: the standard "SPA under IIS" fallback
  rule so Vue Router's client-side routes (e.g. /account-progress/42) resolve
  to index.html instead of a raw IIS 404, while real static files (JS/CSS/
  images) and anything under /BlueTrack (the nested ASP.NET Core Application,
  which has its own web.config generated by `dotnet publish`) are left alone.

  D-163: the nested Application is named "BlueTrack", not "api", because
  its own controllers' route templates already start with a literal "api/"
  segment (e.g. [Route("api/auth")]), and ANCM's PathBase stripping for a
  nested Application always removes that Application's own FULL mounted
  virtual path. Naming it "/api" meant PathBase consumed the exact "api"
  segment the controllers also expected to see in the remaining path,
  requiring a doubled-up "/api/api/..." externally to actually reach
  anything. Naming it "/BlueTrack" instead leaves "api/..." intact in the
  request path after stripping, matching the controllers' own routes with
  no code changes and no double prefix, so the real external API root
  becomes /BlueTrack/api/...

  D-166: D-163 fixed the API's OWN server-side routing (verified via
  direct curl/PowerShell requests), but never verified through an actual
  browser, and the SPA's own frontend code (App/Web/src/**/*.vue) calls
  fetch('/api/...') everywhere, matching the ORIGINAL contract Vite's own
  dev-server proxy has always used and still uses today. Once deployed
  behind IIS with the API now living at /BlueTrack/api/..., those
  unmodified /api/... calls no longer match ANY nested Application, so
  IIS's own SPA-fallback rule below caught them and served index.html,
  and the browser's fetch() then failed trying to parse that HTML as JSON.
  This rule bridges the gap transparently, server-side, before the SPA
  fallback ever runs: any request under /api/ is silently rewritten,
  not redirected (the browser's own URL/JS never see this happen), to
  /BlueTrack/api/, which D-163's real nested Application then serves
  correctly. This keeps the frontend build, the Vite dev proxy, and
  App/E2E completely untouched and environment-agnostic, since none of
  them need to know the IIS-specific nested Application's own name.

  Requires the IIS URL Rewrite Module (verified/installed by
  Deploy/Modules/BlueTrack.Prereqs.psm1 before this file is ever deployed).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="BlueTrack API back-compat bridge (D-166)" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="BlueTrack/api/{R:1}" />
        </rule>
        <rule name="BlueTrack SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/BlueTrack(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- IIS's default MIME map already includes .json in most versions; this
           guards the rare configuration where it doesn't, since Vite build
           output (manifest files, etc.) includes .json assets. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
