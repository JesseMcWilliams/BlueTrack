<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.11" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!--
    CyberArk CP integration (D-32/D-38/D-40, Design_Secrets_Storage.md).
    Referenced directly from the Credential Provider's local install rather
    than a NuGet package or a copy checked into this repo: CyberArk
    doesn't publish this SDK to NuGet, and committing a vendor binary into
    git raises its own licensing/redistribution questions this project
    hasn't needed to answer for any other dependency. This DOES mean a
    build only succeeds on a machine with the CP's Application Password SDK
    installed and findable, an accepted constraint, consistent with how
    this whole app already assumes a specific environment (D-09 single
    server, domain-joined, Windows-only per BlueTrack.Api's
    SupportedOSPlatform).

    CyberArkSdkPath below defaults to this box's actual install path.
    Override it, rather than editing this tracked file, if another
    machine's CP is installed somewhere else: create a local,
    git-ignored BlueTrack.Api.csproj.user next to this file with a
    CyberArkSdkPath element in a PropertyGroup (MSBuild auto-imports
    *.csproj.user; see App/Api/BlueTrack.Api.csproj.user on this box for
    a template), or set a CyberArkSdkPath environment variable, which
    MSBuild falls back to for any property nothing else sets.
  -->
  <PropertyGroup>
    <CyberArkSdkPath Condition="'$(CyberArkSdkPath)' == ''">C:\Program Files\CyberArk\ApplicationPasswordSdk</CyberArkSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NetStandardPasswordSDK">
      <HintPath>$(CyberArkSdkPath)\NetStandardPasswordSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
