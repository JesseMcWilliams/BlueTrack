<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- D-226: the release version. Tools/New-BlueTrackRelease.ps1 sets it at a
         release (tag vX.Y.Z -> X.Y.Z); don't bump it by hand. Between releases
         the build stamps a dev version from git (BlueTrackStampVersion below);
         About and the Deployment page show that stamp. -->
    <Version>1.0.5</Version>
    <!-- D-226: the stamp below carries the commit itself, so the SDK's own
         "+<full commit sha>" (SourceLink) isn't appended to InformationalVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    D-226: build stamp. Runs before the SDK's GetAssemblyVersion, which only
    defaults InformationalVersion to $(Version) when it's still empty.
      on the release tag v$(Version), clean tree  -> 1.0.0
      N commits after the latest v* tag            -> 1.0.0-dev.N+abc1234
      no v* tag reachable (e.g. shallow clone)     -> 1.0.0-dev+abc1234
      any of the dev forms with local changes      -> ...+abc1234.dirty
      no git, no .git (source zip), or git fails   -> 1.0.0 (InformationalVersion left unset)
    Every git call ignores its exit code and errors, so a missing or failing
    git never fails the build. Set BlueTrackStampVersion=false to skip it.
  -->
  <Target Name="BlueTrackStampVersion"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(BlueTrackStampVersion)' != 'false' and '$(InformationalVersion)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\.git')">
    <Exec Command="git describe --tags --long --match &quot;v[0-9]*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" EchoOff="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BtDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_BtDescribeExit" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" EchoOff="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BtSha" />
      <Output TaskParameter="ExitCode" PropertyName="_BtShaExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" EchoOff="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BtStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_BtStatusExit" />
    </Exec>

    <PropertyGroup>
      <_BtDescribe>$(_BtDescribe.Trim())</_BtDescribe>
      <_BtSha>$(_BtSha.Trim())</_BtSha>
      <_BtShaOk>false</_BtShaOk>
      <_BtShaOk Condition="'$(_BtShaExit)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_BtSha)', '^[0-9a-f]{7,40}$'))">true</_BtShaOk>
      <_BtDescribeOk>false</_BtDescribeOk>
      <_BtDescribeOk Condition="'$(_BtShaOk)' == 'true' and '$(_BtDescribeExit)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_BtDescribe)', '^v.+-\d+-g[0-9a-f]+$'))">true</_BtDescribeOk>
      <_BtDirty></_BtDirty>
      <_BtDirty Condition="'$(_BtStatusExit)' == '0' and '$(_BtStatus.Trim())' != ''">.dirty</_BtDirty>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_BtDescribeOk)' == 'true'">
      <_BtTag>$([System.Text.RegularExpressions.Regex]::Replace('$(_BtDescribe)', '^(v.+)-\d+-g[0-9a-f]+$', '$1'))</_BtTag>
      <_BtHeight>$([System.Text.RegularExpressions.Regex]::Replace('$(_BtDescribe)', '^v.+-(\d+)-g[0-9a-f]+$', '$1'))</_BtHeight>
      <InformationalVersion>$(Version)-dev.$(_BtHeight)+$(_BtSha)$(_BtDirty)</InformationalVersion>
      <InformationalVersion Condition="'$(_BtHeight)' == '0' and '$(_BtTag)' == 'v$(Version)' and '$(_BtDirty)' == ''">$(Version)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_BtDescribeOk)' != 'true' and '$(_BtShaOk)' == 'true'">
      <InformationalVersion>$(Version)-dev+$(_BtSha)$(_BtDirty)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="low" Text="BlueTrackStampVersion: InformationalVersion=$(InformationalVersion) (describe '$(_BtDescribe)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.11" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.13" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Direct pins over vulnerable transitive floors (D-153; raised to 10.0.13 for
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83 (Xml) and
         GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 (Pkcs)). Xml comes via
         ITfoxtec.Identity.Saml2; Pkcs via Cryptography.Xml, MimeKit and SqlClient.
         NU1510: on net10.0 the Xml assembly always comes from the ASP.NET Core
         shared runtime (the package resolves to _._), so the Xml fix needs the
         10.0.13+ hosting bundle; Pkcs 10.0.13 ships in bin and wins over 10.0.11. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <!--
    CyberArk CP integration (D-32/D-38/D-40, Design_Secrets-Storage.md).
    Referenced directly from the Credential Provider's local install rather
    than a NuGet package or a copy checked into this repo: CyberArk
    doesn't publish this SDK to NuGet, and committing a vendor binary into
    git raises its own licensing/redistribution questions this project
    hasn't needed to answer for any other dependency.

    Optional since D-169: on a machine without the SDK, the reference and
    CyberArkCpSecretsProvider.cs are left out and the API builds without
    the CyberArk CP backend. The path default, its overrides (including
    App/Api/BlueTrack.Api.csproj.user) and the CYBERARK_CP constant live in
    ../CyberArkSdk.targets. Item conditions, unlike top-level property
    conditions, see the final CyberArkSdkPath, including a .csproj.user
    override.
  -->
  <Import Project="..\CyberArkSdk.targets" />
  <ItemGroup Condition="Exists('$(CyberArkSdkPath)\NetStandardPasswordSDK.dll')">
    <Reference Include="NetStandardPasswordSDK">
      <HintPath>$(CyberArkSdkPath)\NetStandardPasswordSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(CyberArkSdkPath)\NetStandardPasswordSDK.dll')">
    <Compile Remove="Secrets\CyberArkCpSecretsProvider.cs" />
  </ItemGroup>

  <!--
    D-230: appsettings.Site.json is written by the installer next to the
    published API and holds that site's connection string. A copy left in this
    folder must never be built or published over it.
  -->
  <ItemGroup>
    <Content Remove="appsettings.Site.json" />
  </ItemGroup>

  <!--
    Embedded so the Group / Role Mapping page's script-generator endpoint
    (GroupRoleMappingsController) can read this tracked script's content at
    runtime regardless of deployment layout: Deploy/Install-BlueTrack.ps1
    publishes the API output separately from the repo, so Database/*.sql
    is not otherwise guaranteed to exist alongside a running deployment.
    The tracked Database/32 file stays the one source of truth; this just
    compiles a copy of it into the DLL.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Database\Manual\03_BlueTrack_GrantBackupStatusReaderRole.sql">
      <LogicalName>BlueTrack.Api.GrantBackupStatusReaderRole.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
