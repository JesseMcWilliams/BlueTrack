<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- D-96 Part 3.1: no automated versioning/CI-stamping pipeline exists yet,
         so this is a manually-maintained starting point, bumped by hand per real
         release, just enough for the new Deployment admin page to answer
         "what's running now." -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.11" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.11" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <!--
    CyberArk CP integration (D-32/D-38/D-40, Design_Secrets-Storage.md).
    Referenced directly from the Credential Provider's local install rather
    than a NuGet package or a copy checked into this repo: CyberArk
    doesn't publish this SDK to NuGet, and committing a vendor binary into
    git raises its own licensing/redistribution questions this project
    hasn't needed to answer for any other dependency.

    Optional since D-169: on a machine without the SDK, the reference and
    CyberArkCpSecretsProvider.cs are left out and the API builds without
    the CyberArk CP backend. The path default, its overrides (including
    App/Api/BlueTrack.Api.csproj.user) and the CYBERARK_CP constant live in
    ../CyberArkSdk.targets. Item conditions, unlike top-level property
    conditions, see the final CyberArkSdkPath, including a .csproj.user
    override.
  -->
  <Import Project="..\CyberArkSdk.targets" />
  <ItemGroup Condition="Exists('$(CyberArkSdkPath)\NetStandardPasswordSDK.dll')">
    <Reference Include="NetStandardPasswordSDK">
      <HintPath>$(CyberArkSdkPath)\NetStandardPasswordSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(CyberArkSdkPath)\NetStandardPasswordSDK.dll')">
    <Compile Remove="Secrets\CyberArkCpSecretsProvider.cs" />
  </ItemGroup>

  <!--
    Embedded so the Group / Role Mapping page's script-generator endpoint
    (GroupRoleMappingsController) can read this tracked script's content at
    runtime regardless of deployment layout: Deploy/Install-BlueTrack.ps1
    publishes the API output separately from the repo, so Database/*.sql
    is not otherwise guaranteed to exist alongside a running deployment.
    The tracked Database/32 file stays the one source of truth; this just
    compiles a copy of it into the DLL.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Database\38_BlueTrack_GrantBackupStatusReaderRole.sql">
      <LogicalName>BlueTrack.Api.GrantBackupStatusReaderRole.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
